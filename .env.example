# Copy this file to .env and fill in your values
# PosInsight 在正式機的 integration_pos_db 容器（Integration_of_POS 管理，port 1434）
#   正式機本機：127.0.0.1,1434；開發機（須在 CF 網段）：<正式機 IP>,1434
DB_SERVER=127.0.0.1,1434
DB_NAME=PosInsight
# 專用帳號（db/prod_restore.sql 建立），不用 sa
DB_USER=
DB_PASSWORD=
# SOKUHO PDF 根目錄（僅此樹狀目錄；依年度分子資料夾如 SOKUHO\2026）
PDF_DIR=E:\OneDrive - Aunt Stella Company\SOKUHO
# 同步異常／失敗通知收件人（Gmail API；正常成功不寄信）
NOTIFY_EMAIL=robert@auntstella.com.tw
# 公司 Gmail（OAuth login_hint + 帳號驗證；排程必用此信箱）
GMAIL_LOGIN_HINT=robert@auntstella.com.tw
# Edge 公司設定檔資料夾名稱；留空時依 GMAIL_LOGIN_HINT 從 Edge Local State 自動找
EDGE_PROFILE_DIR=
# 每日 .bak 備份目的地（UNC，不用磁碟機代號；只在正式機用）；首次搬遷的 .bak 在其下 migration\
SOKUHO_BAK_DEST=
# SOKUHO 報表寄件者（逗號分隔；含代班 mantsu / billy，勿只留 bellecheng）
SOKUHO_GMAIL_SENDERS=bellecheng@auntstella.com.tw,mantsu@auntstella.com.tw,billy@auntstella.com.tw
